<!DOCTYPE html>
<html lang="fi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= metaDescription %>">
    <title><%= documentTitle %></title>
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= metaUrl %>">
    <meta property="og:title" content="<%= metaTitle %>">
    <meta property="og:description" content="<%= metaDescription %>">
    <meta property="og:site_name" content="Talviliiga">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.5; background: #f1f5f9; color: #1e293b; min-height: 100vh; display: flex; flex-direction: column; }
        .container { width: 100%; max-width: 48rem; margin: 0 auto; flex: 1; }
        header { background: #1d4ed8; color: white; padding: 1rem; border-radius: 0 0 0.5rem 0.5rem; box-shadow: 0 4px 6px -1px rgb(0 0 0 / .1); }
        header a { color: white; text-decoration: none; font-size: 0.875rem; }
        h1 { font-size: 1.25rem; font-weight: 700; margin-top: 0.25rem; }
        .time-range { font-size: 0.9375rem; color: #dbeafe; }
        main { padding: 1rem; margin-top: 1rem; display: flex; flex-direction: column; gap: 0.75rem; }
        @media (min-width: 768px) { main { padding: 2rem; } }
        .card { background: white; padding: 1rem; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgb(0 0 0 / .1); border-left: 4px solid #1d4ed8; }
        .card a { color: #1d4ed8; font-weight: 700; font-size: 1.0625rem; }
        .row { font-size: 0.875rem; color: #475569; margin-top: 0.25rem; }
        .time { font-weight: 700; color: #1e293b; }
        footer { background: #1e293b; color: #cbd5e1; text-align: center; padding: 1rem; font-size: 0.875rem; margin-top: 3rem; }
        footer a { color: #93c5fd; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <a href="/">← Takaisin</a>
            <h1><%= baseTeamName %></h1>
            <% if (nextDate) { %>
                <div class="time-range">Seuraava pelipäivä <%= nextDate %><% if (firstGameTime && lastGameEndTime) { %> · <%= firstGameTime %>–<%= lastGameEndTime %><% } %></div>
            <% } %>
        </header>
        <main>
            <% subteams.forEach(st => { %>
                <div class="card">
                    <a href="/team/<%= encodeURIComponent(st.name) %>"><%= st.name %></a>
                    <% if (!st.next) { %>
                        <div class="row">Ei tulevia pelipäiviä</div>
                    <% } else { %>
                        <div class="row"><%= st.next.dateLabel %> · <%= st.next.location %><% if (st.next.series.length) { %> · <%= st.next.series.join(', ') %><% } %></div>
                        <% if (st.next.games.length) { %>
                            <div class="row">Eka peli <span class="time"><%= st.next.firstTime %></span><% if (st.next.lastEnd) { %> · vika loppuu <span class="time"><%= st.next.lastEnd %></span><% } %> · <%= st.next.games.length %> peliä</div>
                        <% } else { %>
                            <div class="row">Otteluohjelma julkaistaan myöhemmin</div>
                        <% } %>
                    <% } %>
                </div>
            <% }); %>
        </main>
    </div>
    <footer>
        <p>Talviliiga<% if (lastUpdated) { %> · Päivitetty <%= new Date(lastUpdated).toLocaleString('fi-FI', { timeZone: 'Europe/Helsinki' }) %><% } %></p>
    </footer>
</body>
</html>
