<!DOCTYPE html>
<html lang="fi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= metaDescription %>">
    <title><%= documentTitle %></title>
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= metaUrl %>">
    <meta property="og:title" content="<%= metaTitle %>">
    <meta property="og:description" content="<%= metaDescription %>">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.5; background: #f1f5f9; color: #1e293b; min-height: 100vh; }
        .container { width: 100%; max-width: 48rem; margin: 0 auto; }
        header { background: #15803d; color: white; padding: 1rem; border-radius: 0 0 0.5rem 0.5rem; box-shadow: 0 4px 6px -1px rgb(0 0 0 / .1); }
        header a { color: #86efac; text-decoration: none; font-size: 0.875rem; }
        h1 { font-size: 1.25rem; font-weight: 700; margin-top: 0.25rem; }
        main { padding: 1rem; margin-top: 1rem; }
        @media (min-width: 768px) { main { padding: 2rem; } }
        .subteam-card { background: white; padding: 1.25rem; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgb(0 0 0 / .1); border-left: 4px solid #16a34a; margin-bottom: 1rem; }
        .subteam-card:hover { box-shadow: 0 10px 15px -3px rgb(0 0 0 / .1); }
        .subteam-name { font-size: 1.125rem; font-weight: 600; margin-bottom: 0.25rem; }
        .subteam-name a { color: #15803d; text-decoration: none; }
        .subteam-name a:hover { text-decoration: underline; }
        .next-game { font-size: 0.875rem; color: #475569; }
        .next-game .time { font-weight: 700; color: #166534; }
        .no-game { font-size: 0.875rem; color: #94a3b8; }
        footer { background: #1e293b; color: #cbd5e1; text-align: center; padding: 1rem; margin-top: 3rem; font-size: 0.875rem; }
        footer a { color: #4ade80; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <a href="/">← Takaisin</a>
            <h1><%= baseTeamName %></h1>
        </header>
        <main>
            <% subteams.forEach(st => { %>
                <div class="subteam-card">
                    <div class="subteam-name">
                        <a href="/team/<%= encodeURIComponent(st.name) %>"><%= st.name %></a>
                    </div>
                    <% if (st.nextGame) { %>
                        <div class="next-game">
                            Seuraava: <span class="time"><%= st.nextGame.time %></span>
                            <%= st.nextGame.fullDate || st.nextGame.date %> –
                            <%= st.nextGame.opponent %>
                            (<%= st.nextGame.field %>)
                        </div>
                    <% } else { %>
                        <div class="no-game">Ei tulevia pelejä</div>
                    <% } %>
                </div>
            <% }); %>
        </main>
        <footer>
            <p>OLS Viikkopelit &nbsp;|&nbsp; <a href="/admin">Admin</a></p>
        </footer>
    </div>
</body>
</html>
